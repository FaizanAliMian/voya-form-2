{
    "jobs": [{
        "functionLocation": "/elavonPoll.web.js",
        "functionName": "pollElavonNotifications",
        "description": "Catch missed BLIK/async payments Elavon settled but Wix never heard about",
        "executionConfig": {
            "cronExpression": "0 * * * *"
        }
    }, {
        "functionLocation": "/receiptReconcile.js",
        "functionName": "reconcileReceipts",
        "description": "Hourly check (at :30, offset from the Elavon poll at :00): paid Wix orders vs eparagony receipts in both directions; logs to ReceiptEventLog and emails each new mismatch once",
        "executionConfig": {
            "cronExpression": "30 * * * *"
        }
    }]
}
